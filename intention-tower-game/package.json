{
  "name": "intention-tower-game",
  "private": true,
  "version": "0.9.0",
  "description": "A deterministic mind-graph simulation strategy game for desktop and mobile",
  "type": "module",
  "scripts": {
    "tauri:dev": "tauri dev",
    "start:mcp": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features test-server --example intention-tower-mcp",
    "start:mcp:desktop": "tauri dev --features test-server -- --test-mode",
    "tauri:test": "tauri dev --features test-server -- --test-mode",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --features test-server --lib --tests",
    "test:mcp:levels": "node scripts/verify-all-levels-mcp.mjs",
    "test:assets": "node scripts/verify-production-assets.mjs",
    "test:ui": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint ./src --ext js,ts,tsx,json",
    "check": "tsc --noEmit --skipLibCheck",
    "lint:fix": "eslint ./src --ext ts,tsx --fix",
    "gen:mod:gpt-image-2:manifest": "node scripts/create-gpt-image-2-manifest.mjs",
    "gen:mod:gpt-image-2:portraits": "node scripts/generate-gpt-image-2-portraits.mjs",
    "gen:mod:qwen": "node scripts/generate-qwen-mod-images.mjs",
    "gen:mod:qwen:manifest": "node scripts/generate-qwen-mod-images.mjs --manifest-only",
    "gen:mod:qwen:bg": "node scripts/generate-qwen-mod-images.mjs --type background"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "@tauri-apps/api": "2.5.0",
    "@tauri-apps/plugin-opener": "2.3.0",
    "d3-force": "^3.0.0",
    "i18next": "^25.8.13",
    "pixi.js": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.5.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-config-tidgi": "^2.2.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
