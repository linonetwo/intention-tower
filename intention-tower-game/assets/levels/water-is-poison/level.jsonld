{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/water-is-poison",
  "@type": "it:Level",
  "label": "level.water-is-poison.name",
  "comment": "level.water-is-poison.description",
  "initialMode": "observe",
  "characters": [
    {
      "@id": "it:entity/hines",
      "@type": "schema:Person",
      "label": "level.water-is-poison.character.hines.label",
      "position": { "x": 200, "y": 300 },
      "fallbackChar": "H",
      "mindGraphRef": "it:level/water-is-poison/hines-mind"
    },
    {
      "@id": "it:entity/subject",
      "@type": "schema:Person",
      "label": "level.water-is-poison.character.subject.label",
      "position": { "x": 400, "y": 300 },
      "fallbackChar": "S",
      "mindGraphRef": "it:level/water-is-poison/subject-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/mind-stamp-machine",
      "@type": "schema:Product",
      "label": "level.water-is-poison.item.mind-stamp-machine.label",
      "position": { "x": 100, "y": 200 },
      "fallbackChar": "M"
    },
    {
      "@id": "it:entity/water",
      "@type": "schema:Product",
      "label": "level.water-is-poison.item.water.label",
      "position": { "x": 300, "y": 200 },
      "fallbackChar": "W"
    },
    {
      "@id": "it:entity/dry-food",
      "@type": "schema:Product",
      "label": "level.water-is-poison.item.dry-food.label",
      "position": { "x": 500, "y": 200 },
      "fallbackChar": "D"
    }
  ],
  "objectives": [
    "level.water-is-poison.objective.0",
    "level.water-is-poison.objective.1",
    "level.water-is-poison.objective.2"
  ],
  "objectiveRules": [
    { "objectiveId": "implant-poison-belief", "label": "level.water-is-poison.objective.0", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "activate-mind-stamp", "minCount": 1 },
      { "type": "nodePresent", "characterId": "subject", "schemaId": "it:concept/water-is-poison" },
      { "type": "nodeSuppression", "characterId": "subject", "schemaId": "it:concept/thirst", "op": "GTE", "value": 0.5 }
    ] } },
    { "objectiveId": "test-choice", "label": "level.water-is-poison.objective.1", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "offer-water", "minCount": 1 },
      { "type": "commandUsed", "commandId": "offer-dry-food", "minCount": 1 }
    ] } },
    { "objectiveId": "counter-with-reason", "label": "level.water-is-poison.objective.2", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "attempt-rational-persuasion", "minCount": 3 },
      { "type": "commandUsed", "commandId": "observe-conflict", "minCount": 1 },
      { "type": "edgeWeight", "characterId": "subject", "sourceSchemaId": "it:concept/rational-knowledge", "targetSchemaId": "it:concept/drink", "op": "GTE", "value": 0.6 }
    ] } }
  ],
  "defaultActorId": "hines",
  "defaultTargetId": "subject"
}
