{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/collapse",
  "@type": "it:Level",
  "label": "level.collapse.name",
  "comment": "level.collapse.description",
  "initialMode": "observe",
  "characters": [
    {
      "@id": "it:entity/student-worker",
      "@type": "schema:Person",
      "label": "level.collapse.character.student-worker.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "S",
      "mindGraphRef": "it:level/collapse/student-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/exam-result",
      "@type": "schema:Product",
      "label": "level.collapse.item.exam-result.label",
      "position": { "x": 200, "y": 200 },
      "fallbackChar": "E"
    },
    {
      "@id": "it:entity/work-task",
      "@type": "schema:Product",
      "label": "level.collapse.item.work-task.label",
      "position": { "x": 400, "y": 200 },
      "fallbackChar": "W"
    }
  ],
  "objectives": [
    "level.collapse.objective.0",
    "level.collapse.objective.1",
    "level.collapse.objective.2"
  ],
  "objectiveRules": [
    { "objectiveId": "raise-pressure", "label": "level.collapse.objective.0", "condition": { "type": "commandUsed", "commandId": "deliver-bad-news", "minCount": 2 } },
    { "objectiveId": "observe-erosion", "label": "level.collapse.objective.1", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "add-pressure", "minCount": 1 },
      { "type": "tickAtLeast", "tick": 2 }
    ] } },
    { "objectiveId": "restore-intrinsic", "label": "level.collapse.objective.2", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "encourage-intrinsic", "minCount": 2 },
      { "type": "nodeValue", "characterId": "student-worker", "schemaId": "it:concept/joy-of-learning", "op": "GTE", "value": 0.3 }
    ] } }
  ],
  "defaultActorId": "student-worker",
  "defaultTargetId": "student-worker"
}
