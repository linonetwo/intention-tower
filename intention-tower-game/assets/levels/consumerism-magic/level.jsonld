{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/consumerism-magic",
  "@type": "it:Level",
  "label": "level.consumerism-magic.name",
  "comment": "level.consumerism-magic.description",
  "initialMode": "observe",
  "characters": [
    {
      "@id": "it:entity/magic-merchant",
      "@type": "schema:Person",
      "label": "level.consumerism-magic.character.magic-merchant.label",
      "position": { "x": 300, "y": 100 },
      "fallbackChar": "$",
      "mindGraphRef": "it:level/consumerism-magic/merchant-mind"
    },
    {
      "@id": "it:entity/citizen-1",
      "@type": "schema:Person",
      "label": "level.consumerism-magic.character.citizen-1.label",
      "position": { "x": 200, "y": 300 },
      "fallbackChar": "c",
      "mindGraphRef": "it:level/consumerism-magic/citizen-mind"
    },
    {
      "@id": "it:entity/citizen-2",
      "@type": "schema:Person",
      "label": "level.consumerism-magic.character.citizen-2.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "c",
      "mindGraphRef": "it:level/consumerism-magic/citizen-mind"
    },
    {
      "@id": "it:entity/citizen-3",
      "@type": "schema:Person",
      "label": "level.consumerism-magic.character.citizen-3.label",
      "position": { "x": 400, "y": 300 },
      "fallbackChar": "c",
      "mindGraphRef": "it:level/consumerism-magic/citizen-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/magic-billboard",
      "@type": "schema:Product",
      "label": "level.consumerism-magic.item.magic-billboard.label",
      "position": { "x": 100, "y": 200 },
      "fallbackChar": "B"
    },
    {
      "@id": "it:entity/magic-product",
      "@type": "schema:Product",
      "label": "level.consumerism-magic.item.magic-product.label",
      "position": { "x": 500, "y": 200 },
      "ownerId": "it:entity/magic-merchant",
      "quantity": 100,
      "unitPrice": 12,
      "fallbackChar": "P"
    },
    {
      "@id": "it:entity/magic-workshop",
      "@type": "schema:Place",
      "label": "level.consumerism-magic.item.magic-workshop.label",
      "position": { "x": 100, "y": 400 },
      "fallbackChar": "W"
    },
    {
      "@id": "it:entity/meme-workbench",
      "@type": "schema:Product",
      "label": "level.consumerism-magic.item.meme-workbench.label",
      "position": { "x": 200, "y": 400 },
      "fallbackChar": "M"
    }
  ],
  "objectives": [
    "level.consumerism-magic.objective.0",
    "level.consumerism-magic.objective.1",
    "level.consumerism-magic.objective.2"
  ],
  "objectiveRules": [
    { "objectiveId": "advertise-to-citizens", "label": "level.consumerism-magic.objective.0", "condition": { "type": "commandUsed", "commandId": "cast-magic-ad", "minCount": 3, "distinctTargets": 3 } },
    { "objectiveId": "brand-identity", "label": "level.consumerism-magic.objective.1", "condition": { "type": "commandUsed", "commandId": "enhance-brand", "minCount": 3, "distinctTargets": 3 } },
    { "objectiveId": "sustain-demand", "label": "level.consumerism-magic.objective.2", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "set-up-shop", "minCount": 3, "distinctTargets": 3 },
      { "type": "assetTransactions", "itemId": "magic-product", "minCount": 3, "distinctBuyers": 3 }
    ] } }
  ],
  "defaultActorId": "magic-merchant",
  "defaultTargetId": "citizen-1"
}
