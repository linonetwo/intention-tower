{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/consumerism-magic/commands",
  "commands": [
    {
      "commandId": "cast-magic-ad",
      "label": "command.cast-magic-ad.label",
      "hotkey": "1",
      "targeting": "RequiresTarget",
      "preconditions": [],
      "effects": [
        {
          "type": "InjectMeme",
          "memeSchemaId": "it:concept/desire-for-magic-product",
          "targetCharacterId": "__target",
          "meme": { "bindingSites": ["it:concept/basic-needs"], "resilience": 0.42 }
        },
        {
          "type": "SpawnObservation",
          "schemaId": "it:concept/see-magic-ad",
          "modality": "Visual",
          "about": "it:entity/magic-billboard",
          "ttl": 300,
          "strength": 0.9,
          "targetCharacterId": "__target"
        }
      ]
    },
    {
      "commandId": "craft-product",
      "label": "command.craft-product.label",
      "hotkey": "2",
      "targeting": "NoTarget",
      "preconditions": [],
      "effects": [
        {
          "type": "SpawnObservation",
          "schemaId": "it:concept/see-magic-ad",
          "modality": "Visual",
          "about": "it:entity/magic-product",
          "ttl": 100,
          "strength": 0.3,
          "targetCharacterId": "__target"
        }
      ]
    },
    {
      "commandId": "set-up-shop",
      "label": "command.set-up-shop.label",
      "hotkey": "3",
      "targeting": "RequiresTarget",
      "preconditions": [],
      "effects": [
        {
          "type": "ModifyNodeValue",
          "schemaId": "it:concept/desire-for-magic-product",
          "delta": 0.1,
          "targetCharacterId": "__target"
        },
        {
          "type": "SetAssetPrice",
          "itemId": "it:entity/magic-product",
          "unitPrice": 12
        },
        {
          "type": "TradeAsset",
          "itemId": "it:entity/magic-product",
          "buyerId": "__target",
          "sellerId": "__actor",
          "quantity": 1
        }
      ]
    },
    {
      "commandId": "enhance-brand",
      "label": "command.enhance-brand.label",
      "hotkey": "4",
      "targeting": "RequiresTarget",
      "preconditions": [],
      "effects": [
        {
          "type": "InjectMeme",
          "memeSchemaId": "it:concept/brand-identity",
          "targetCharacterId": "__target",
          "meme": { "bindingSites": ["it:concept/desire-for-magic-product"], "isIdentity": true, "groupId": "magic-brand", "resilience": 0.6 }
        }
      ]
    }
  ]
}
