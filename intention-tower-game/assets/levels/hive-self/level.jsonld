      "label": "level.hive-self.character.clone-b.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "B",
      "mindGraphRef": "it:level/hive-self/clone-mind"
    },
    {
      "@id": "it:entity/clone-c",
      "@type": "schema:Person",
      "label": "level.hive-self.character.clone-c.label",
      "position": { "x": 400, "y": 300 },
      "fallbackChar": "C",
      "mindGraphRef": "it:level/hive-self/clone-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/scarce-habitat",
      "@type": "schema:Place",
