{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/gosling/commands",
  "commands": [
    {
      "commandId": "approach-gosling",
      "label": "command.approach-gosling.label",
      "hotkey": "1",
      "targeting": "RequiresTarget",
      "preconditions": [
        { "type": "ActorIs", "characterIds": ["lorenz"] },
        { "type": "TargetIs", "characterIds": ["gosling"] },
        { "type": "TargetIsNotActor" }
      ],
      "effects": [
        {
          "type": "SpawnObservation",
          "schemaId": "it:concept/see-contact-object",
          "modality": "Visual",
          "about": "it:entity/lorenz",
          "ttl": 300,
          "strength": 0.9,
          "targetCharacterId": "__target"
        }
      ]
    },
    {
      "commandId": "make-sound",
      "label": "command.make-sound.label",
      "hotkey": "2",
      "targeting": "RequiresTarget",
      "preconditions": [
        { "type": "ActorIs", "characterIds": ["lorenz"] },
        { "type": "TargetIs", "characterIds": ["gosling"] },
        { "type": "TargetIsNotActor" }
      ],
      "effects": [
        {
          "type": "SpawnObservation",
          "schemaId": "it:concept/hear-contact-object",
          "modality": "Auditory",
          "about": "it:entity/lorenz",
          "ttl": 200,
          "strength": 0.7,
          "targetCharacterId": "__target"
        }
      ]
    },
    {
      "commandId": "move-away",
      "label": "command.move-away.label",
      "hotkey": "3",
      "targeting": "RequiresTarget",
      "preconditions": [
        { "type": "ActorIs", "characterIds": ["lorenz"] },
        { "type": "TargetIs", "characterIds": ["gosling"] },
        { "type": "TargetIsNotActor" }
      ],
      "effects": [
        {
          "type": "MoveCharacter",
          "deltaX": -40.0,
          "deltaY": 0.0,
          "targetCharacterId": "__actor"
        }
      ]
    },
    {
      "commandId": "show-decoy",
      "label": "command.show-decoy.label",
      "hotkey": "4",
      "targeting": "RequiresTarget",
      "preconditions": [
        { "type": "ActorIs", "characterIds": ["lorenz"] },
        { "type": "TargetIs", "characterIds": ["gosling"] },
        { "type": "TargetIsNotActor" },
        { "type": "EnvHasItem", "itemSchemaId": "schema:Product" }
      ],
      "effects": [
        {
          "type": "SpawnObservation",
          "schemaId": "it:concept/see-contact-object",
          "modality": "Visual",
          "about": "it:entity/mother-goose-decoy",
          "ttl": 300,
          "strength": 0.8,
          "targetCharacterId": "__target"
        }
      ]
    }
  ]
}
