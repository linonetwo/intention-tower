{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/internet-addict",
  "@type": "it:Level",
  "label": "level.internet-addict.name",
  "comment": "level.internet-addict.description",
  "initialMode": "observe",
  "characters": [
    {
      "@id": "it:entity/addict-teen",
      "@type": "schema:Person",
      "label": "level.internet-addict.character.addict-teen.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "T",
      "mindGraphRef": "it:level/internet-addict/teen-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/gaming-pc",
      "@type": "schema:Product",
      "label": "level.internet-addict.item.gaming-pc.label",
      "position": { "x": 200, "y": 200 },
      "fallbackChar": "G"
    },
    {
      "@id": "it:entity/textbook",
      "@type": "schema:Product",
      "label": "level.internet-addict.item.textbook.label",
      "position": { "x": 400, "y": 200 },
      "fallbackChar": "B"
    },
    {
      "@id": "it:entity/home",
      "@type": "schema:Place",
      "label": "level.internet-addict.item.home.label",
      "position": { "x": 300, "y": 400 },
      "fallbackChar": "H"
    }
  ],
  "objectives": [
    "level.internet-addict.objective.0",
    "level.internet-addict.objective.1",
    "level.internet-addict.objective.2"
  ],
  "objectiveRules": [
    { "objectiveId": "reduce-boredom", "label": "level.internet-addict.objective.0", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "show-real-world", "minCount": 2 },
      { "type": "nodeValue", "characterId": "addict-teen", "schemaId": "it:concept/boredom", "op": "LTE", "value": 0.1 }
    ] } },
    { "objectiveId": "cut-reward-loop", "label": "level.internet-addict.objective.1", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "cut-game-connection", "minCount": 2 },
      { "type": "edgeWeight", "characterId": "addict-teen", "sourceSchemaId": "it:concept/game-rank", "targetSchemaId": "it:concept/virtual-pleasure", "op": "LTE", "value": 0.31 }
    ] } },
    { "objectiveId": "build-real-meaning", "label": "level.internet-addict.objective.2", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "build-real-meaning", "minCount": 2 },
      { "type": "edgeWeight", "characterId": "addict-teen", "sourceSchemaId": "it:concept/real-study", "targetSchemaId": "it:concept/real-friendship", "op": "GTE", "value": 0.7 }
    ] } }
  ],
  "defaultActorId": "addict-teen",
  "defaultTargetId": "addict-teen"
}
