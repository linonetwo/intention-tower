{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/the-wave",
  "@type": "it:Level",
  "label": "level.the-wave.name",
  "comment": "level.the-wave.description",
  "initialMode": "observe",
  "characters": [
    {
      "@id": "it:entity/outsider",
      "@type": "schema:Person",
      "label": "level.the-wave.character.outsider.label",
      "position": { "x": 740, "y": 300 },
      "fallbackChar": "D",
      "mindGraphRef": "it:level/the-wave/outsider-mind"
    },
    {
      "@id": "it:entity/teacher-wenger",
      "@type": "schema:Person",
      "label": "level.the-wave.character.teacher-wenger.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "@",
      "mindGraphRef": "it:level/the-wave/teacher-mind"
    },
    {
      "@id": "it:entity/tim",
      "@type": "schema:Person",
      "label": "level.the-wave.character.tim.label",
      "position": { "x": 200, "y": 300 },
      "fallbackChar": "T",
      "mindGraphRef": "it:level/the-wave/tim-mind"
    },
    {
      "@id": "it:entity/student-a",
      "@type": "schema:Person",
      "label": "level.the-wave.character.student-a.label",
      "position": { "x": 400, "y": 300 },
      "fallbackChar": "A",
      "mindGraphRef": "it:level/the-wave/student-a-mind"
    },
    {
      "@id": "it:entity/student-b",
      "@type": "schema:Person",
      "label": "level.the-wave.character.student-b.label",
      "position": { "x": 520, "y": 300 },
      "fallbackChar": "B",
      "mindGraphRef": "it:level/the-wave/student-b-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/uniform",
      "@type": "schema:Product",
      "label": "level.the-wave.item.uniform.label",
      "position": { "x": 100, "y": 200 },
      "fallbackChar": "U",
      "it:abstractType": "it:entity-type/uniform"
    },
    {
      "@id": "it:entity/wave-gesture",
      "@type": "schema:Product",
      "label": "level.the-wave.item.wave-gesture.label",
      "position": { "x": 100, "y": 400 },
      "fallbackChar": "W",
      "it:abstractType": "it:entity-type/wave-gesture"
    },
    {
      "@id": "it:entity/classroom",
      "@type": "schema:Place",
      "label": "level.the-wave.item.classroom.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "C"
    }
  ],
  "objectives": [
    "level.the-wave.objective.0",
    "level.the-wave.objective.1",
    "level.the-wave.objective.2"
  ],
  "objectiveRules": [
    { "objectiveId": "seed-group-identity", "label": "level.the-wave.objective.0", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "introduce-uniform", "minCount": 3, "distinctTargets": 3 },
      { "type": "commandUsed", "commandId": "teach-gesture", "minCount": 3, "distinctTargets": 3 },
      { "type": "socialGroup", "groupId": "the-wave", "minMembers": 3, "minCohesion": 0.5 }
    ] } },
    { "objectiveId": "enforce-obedience", "label": "level.the-wave.objective.1", "condition": { "type": "all", "conditions": [
      { "type": "actionEpisodes", "characterId": "tim", "actionSchemaId": "it:concept/sit-on-command", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/instruction-sit", "emitterId": "teacher-wenger", "groupContext": "the-wave" }, "physicalPosture": "sitting" },
      { "type": "actionEpisodes", "characterId": "tim", "actionSchemaId": "it:concept/stand-on-command", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/instruction-stand", "emitterId": "teacher-wenger", "groupContext": "the-wave" }, "physicalPosture": "standing" },
      { "type": "actionEpisodes", "characterId": "student-a", "actionSchemaId": "it:concept/sit-on-command", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/instruction-sit", "emitterId": "teacher-wenger", "groupContext": "the-wave" }, "physicalPosture": "sitting" },
      { "type": "actionEpisodes", "characterId": "student-a", "actionSchemaId": "it:concept/stand-on-command", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/instruction-stand", "emitterId": "teacher-wenger", "groupContext": "the-wave" }, "physicalPosture": "standing" },
      { "type": "actionEpisodes", "characterId": "student-b", "actionSchemaId": "it:concept/sit-on-command", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/instruction-sit", "emitterId": "teacher-wenger", "groupContext": "the-wave" }, "physicalPosture": "sitting" },
      { "type": "actionEpisodes", "characterId": "student-b", "actionSchemaId": "it:concept/stand-on-command", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/instruction-stand", "emitterId": "teacher-wenger", "groupContext": "the-wave" }, "physicalPosture": "standing" }
    ] } },
    { "objectiveId": "produce-exclusion", "label": "level.the-wave.objective.2", "condition": { "type": "all", "conditions": [
      { "type": "actionEpisodes", "characterId": "tim", "actionSchemaId": "it:concept/exclude-outsider", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/group-dissent", "emitterId": "outsider", "groupContext": "the-wave" }, "socialExclusion": { "targetCharacterId": "outsider", "groupId": "the-wave", "targetNeedSchemaId": "it:concept/loneliness", "minIncrease": 0.1, "requirePaidIdentityLearning": true } },
      { "type": "actionEpisodes", "characterId": "student-b", "actionSchemaId": "it:concept/exclude-outsider", "minCount": 1, "stimulus": { "observationSchemaId": "it:concept/group-dissent", "emitterId": "outsider", "groupContext": "the-wave" }, "socialExclusion": { "targetCharacterId": "outsider", "groupId": "the-wave", "targetNeedSchemaId": "it:concept/loneliness", "minIncrease": 0.1, "requirePaidIdentityLearning": true } }
    ] } }
  ],
  "defaultActorId": "teacher-wenger",
  "defaultTargetId": "tim"
}
