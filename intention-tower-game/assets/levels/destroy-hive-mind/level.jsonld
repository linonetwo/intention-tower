    { "objectiveId": "save-power-plant", "label": "level.destroy-hive-mind.objective.3", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "persuade-luddite", "minCount": 4, "distinctTargets": 2 },
      { "type": "edgeWeight", "characterId": "__any", "sourceSchemaId": "it:concept/anti-technology", "targetSchemaId": "it:concept/destroy-power-plant", "op": "LTE", "value": 0.3 }
    ] } }
