  "objectiveRules": [
    { "objectiveId": "hold-relay", "label": "level.destroy-hive-mind.objective.0", "condition": { "type": "commandUsed", "commandId": "defend-station", "minCount": 2 } },
    { "objectiveId": "cleanse-infection", "label": "level.destroy-hive-mind.objective.1", "condition": { "type": "commandUsed", "commandId": "pheromone-attack", "minCount": 2, "distinctTargets": 2 } },
