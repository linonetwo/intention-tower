{
  "@context": { "@import": "../../schema/context.jsonld" },
  "@id": "it:level/illusion-trap",
  "@type": "it:Level",
  "label": "level.illusion-trap.name",
  "comment": "level.illusion-trap.description",
  "initialMode": "observe",
  "characters": [
    {
      "@id": "it:entity/trapped-person",
      "@type": "schema:Person",
      "label": "level.illusion-trap.character.trapped-person.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "T",
      "mindGraphRef": "it:level/illusion-trap/trapped-mind"
    },
    {
      "@id": "it:entity/illusionist",
      "@type": "schema:Person",
      "label": "level.illusion-trap.character.illusionist.label",
      "position": { "x": 100, "y": 100 },
      "fallbackChar": "I",
      "mindGraphRef": "it:level/illusion-trap/illusionist-mind"
    }
  ],
  "items": [
    {
      "@id": "it:entity/illusion-world",
      "@type": "schema:Place",
      "label": "level.illusion-trap.item.illusion-world.label",
      "position": { "x": 300, "y": 300 },
      "fallbackChar": "*"
    },
    {
      "@id": "it:entity/real-danger",
      "@type": "schema:Product",
      "label": "level.illusion-trap.item.real-danger.label",
      "position": { "x": 500, "y": 300 },
      "fallbackChar": "!"
    }
  ],
  "objectives": [
    "level.illusion-trap.objective.0",
    "level.illusion-trap.objective.1",
    "level.illusion-trap.objective.2"
  ],
  "objectiveRules": [
    { "objectiveId": "ground-with-pain", "label": "level.illusion-trap.objective.0", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "inflict-real-pain", "minCount": 2 },
      { "type": "nodeValue", "characterId": "trapped-person", "schemaId": "it:concept/pain-from-reality", "op": "GTE", "value": 0.7 }
    ] } },
    { "objectiveId": "restore-memory", "label": "level.illusion-trap.objective.1", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "trigger-memory-fragment", "minCount": 3 },
      { "type": "nodeValue", "characterId": "trapped-person", "schemaId": "it:concept/real-identity", "op": "GTE", "value": 0.55 }
    ] } },
    { "objectiveId": "call-true-name", "label": "level.illusion-trap.objective.2", "condition": { "type": "all", "conditions": [
      { "type": "commandUsed", "commandId": "call-name", "minCount": 1 },
      { "type": "commandUsed", "commandId": "shake-illusion", "minCount": 2 }
    ] } }
  ],
  "defaultActorId": "illusionist",
  "defaultTargetId": "trapped-person"
}
